# IMAP email (mailbox.org or any IMAP provider)
GATEWAY_IMAP__HOST=imap.mailbox.org
GATEWAY_IMAP__PORT=993
GATEWAY_IMAP__USERNAME=you@example.com
GATEWAY_IMAP__PASSWORD=your-password

# Obsidian vault path
GATEWAY_OBSIDIAN__VAULT_PATH=/Users/you/Obsidian

# Google Calendar (OAuth credentials JSON from `python -m gateway.gcal_auth`, see README)
GATEWAY_GCAL__TOKEN_JSON={"refresh_token": "...", "client_id": "...", "client_secret": "...", ...}

# Karakeep bookmarking service
GATEWAY_KARAKEEP__BASE_URL=https://karakeep.example.com
GATEWAY_KARAKEEP__API_KEY=your-api-key

# OwnTracks Recorder
GATEWAY_OWNTRACKS__BASE_URL=https://owntracks-recorder.example.com
GATEWAY_OWNTRACKS__USERNAME=
GATEWAY_OWNTRACKS__PASSWORD=
GATEWAY_OWNTRACKS__OWNTRACKS_USER=charlie
GATEWAY_OWNTRACKS__OWNTRACKS_DEVICE=

# Vikunja task management
GATEWAY_VIKUNJA__BASE_URL=https://vikunja.example.com
GATEWAY_VIKUNJA__API_TOKEN=your-api-token

# Reminders (Gateway-native SQLite + JSON-HTTP /v1 API)
GATEWAY_REMINDERS__DB_PATH=/var/lib/gateway/reminders.db
GATEWAY_REMINDERS__API_TOKENS=device-phone-token,device-ipad-token
GATEWAY_REMINDERS__NOMINATIM_URL=https://nominatim.example.com

# MCP server (SSE mode)
GATEWAY_SERVER__HOST=127.0.0.1
GATEWAY_SERVER__PORT=4000
# Bearer token(s) required on /mcp (comma-separated, one per client). Leave unset
# to disable auth on /mcp (a startup warning is logged; /v1/* is unaffected, it
# has its own token list above).
GATEWAY_SERVER__AUTH_TOKENS=laptop-mcp-token,scratch-token
