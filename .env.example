# IMAP email (mailbox.org or any IMAP provider)
GATEWAY_IMAP__HOST=imap.mailbox.org
GATEWAY_IMAP__PORT=993
GATEWAY_IMAP__USERNAME=you@example.com
GATEWAY_IMAP__PASSWORD=your-password

# Obsidian vault path
GATEWAY_OBSIDIAN__VAULT_PATH=/Users/you/Obsidian

# apple-calendar-server — real Apple Calendar via EventKit on Malcolm, reached
# server-side only (replaces the old Google Calendar backend)
GATEWAY_CALENDAR_SERVER__BASE_URL=https://apple-calendar.internal
GATEWAY_CALENDAR_SERVER__BEARER_TOKEN=your-token

# Karakeep bookmarking service
GATEWAY_KARAKEEP__BASE_URL=https://karakeep.example.com
GATEWAY_KARAKEEP__API_KEY=your-api-key

# OwnTracks Recorder
GATEWAY_OWNTRACKS__BASE_URL=https://owntracks-recorder.example.com
GATEWAY_OWNTRACKS__USERNAME=
GATEWAY_OWNTRACKS__PASSWORD=
GATEWAY_OWNTRACKS__OWNTRACKS_USER=charlie
GATEWAY_OWNTRACKS__OWNTRACKS_DEVICE=

# Issues — stored as GitHub issues, via the GitHub REST API.
GATEWAY_GITHUB__REPO=awfulwoman/meta
# PAT with "Issues: Read and write" (and Metadata: read) on that repo.
GATEWAY_GITHUB__TOKEN=github_pat_xxx

# Reminders (apple-reminders-server on Malcolm, fronted by Gateway's JSON-HTTP /v1 API)
GATEWAY_REMINDERS__API_TOKENS=device-phone-token,device-ipad-token
GATEWAY_REMINDERS__NOMINATIM_URL=https://nominatim.example.com

# apple-reminders-server — real Apple Reminders via EventKit on Malcolm, reached
# server-side only (never exposed directly to the iOS app or other clients)
GATEWAY_REMINDERS_SERVER__BASE_URL=https://apple-reminders.internal
GATEWAY_REMINDERS_SERVER__BEARER_TOKEN=your-token

# apple-contacts-server — real macOS Contacts via the Contacts framework on
# Malcolm, reached server-side only (replaces Radicale as the contacts backend)
GATEWAY_CONTACTS_SERVER__BASE_URL=https://apple-contacts.internal
GATEWAY_CONTACTS_SERVER__BEARER_TOKEN=your-token

# Radicale (CardDAV) — no longer used by any registered tool (Contacts moved to
# apple-contacts-server above); kept only for the historical migration scripts
# under scripts/ that still speak CardDAV directly
GATEWAY_RADICALE__BASE_URL=https://radicale.internal
GATEWAY_RADICALE__USERNAME=gateway
GATEWAY_RADICALE__PASSWORD=your-password
GATEWAY_RADICALE__CONTACTS_PATH=/gateway/contacts/

# MCP server (SSE mode)
GATEWAY_SERVER__HOST=127.0.0.1
GATEWAY_SERVER__PORT=4000
# Bearer token(s) required on /mcp (comma-separated, one per client). Leave unset
# to disable auth on /mcp (a startup warning is logged; /v1/* is unaffected, it
# has its own token list above).
GATEWAY_SERVER__AUTH_TOKENS=laptop-mcp-token,scratch-token
